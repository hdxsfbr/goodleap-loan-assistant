# Values in this file override variables already exported by your shell.
# Get a key at https://console.anthropic.com/ (API keys). Without a key the app still starts:
# the calculator, the form, the reviewer and audit views work, and the chat input is disabled.
ANTHROPIC_API_KEY=
# optional; set to https://openrouter.ai/api/v1 to use an OpenRouter key
ANTHROPIC_BASE_URL=
PORT=3000
COPILOT_ENABLED=true
EXTRACTION_ENABLED=true
